---
import { Image } from "astro:assets";
import glyphs from "./glyphs";

const subject = [
	"witness",
	"hive",
	"guardian",
	"pyramid",
	"traveller",
	"worm",
	"darkness",
	"light",
	"savathun",
] as const;

const predicate = ["drink", "stop", "give", "kill", "worship"] as const;

const truths: [
	(typeof subject)[number],
	(typeof predicate)[number],
	(typeof subject)[number],
][] = [
	["guardian", "kill", "witness"],
	["guardian", "worship", "traveller"],
	["guardian", "worship", "light"],
	["hive", "worship", "worm"],
	["hive", "worship", "darkness"],
	["darkness", "stop", "savathun"],
	["traveller", "give", "guardian"],
	["traveller", "give", "light"],
	["savathun", "stop", "pyramid"],
	["savathun", "stop", "darkness"],
	["pyramid", "give", "darkness"],
	["pyramid", "kill", "worm"],
	["pyramid", "drink", "worm"],
];

const usedGlyphIds: string[] = [...subject, ...predicate];
const relevantGlyphs = glyphs.filter((glyph) =>
	usedGlyphIds.includes(glyph.id),
);
---

<section id="truths" aria-label="Truths">
	<div class="card-in">
		<p
			class="font-display text-gold-foreground flex items-center gap-x-2 text-xs font-semibold uppercase tracking-[0.2em]"
		>
			<span aria-hidden="true" class="text-[0.6rem]">◆</span>
			Truths
		</p>
		<p class="mt-1 text-sm text-zinc-400">
			Select up to three glyphs to reveal the possible true paths.
		</p>
	</div>

	<div
		class="mt-4 grid max-w-4xl grid-cols-[repeat(auto-fill,6.5rem)] gap-3"
	>
		{
			relevantGlyphs.map((glyph) => (
				<button
					type="button"
					data-glyph={glyph.id}
					class="group data-selected:border-gold data-selected:bg-gold/10 flex cursor-pointer flex-col items-center border border-white/20 bg-zinc-900/60 p-2 transition duration-200 corner-cut [--cut:10px] hover:-translate-y-1 hover:border-white/60 focus-visible:border-white focus-visible:outline-none disabled:cursor-default disabled:opacity-30 disabled:hover:translate-y-0 disabled:hover:border-white/20"
				>
					<Image
						src={glyph.icon}
						alt={glyph.name}
						width={120}
						height={120}
						class="aspect-square w-full brightness-90 transition duration-200 group-hover:brightness-110"
					/>
					<span class="font-display group-data-selected:text-gold mt-1.5 text-[0.65rem] font-semibold uppercase tracking-widest text-zinc-400 transition-colors group-hover:text-white">
						{glyph.name}
					</span>
				</button>
			))
		}
	</div>

	<div id="truth-results" hidden class="mt-8">
		<div class="border-gold/60 border-l-2 pl-4">
			<p
				class="font-display text-gold-foreground text-xs font-semibold uppercase tracking-[0.2em]"
			>
				Possible truths
			</p>
			{
				truths.map((truth) => (
					<div
						data-truth
						data-symbols={truth.join(",")}
						hidden
						class="mt-3 flex items-center gap-x-2"
					>
						{truth.map((symbol, position) => {
							const glyph = glyphs.find((g) => g.id === symbol);
							if (!glyph) {
								return null;
							}
							return (
								<>
									{position > 0 && (
										<span
											aria-hidden="true"
											class="text-gold-foreground text-xs"
										>
											▸
										</span>
									)}
									<div class="flex w-20 flex-col items-center border border-white/15 bg-zinc-900/60 p-1.5 corner-cut [--cut:8px] sm:w-24">
										<Image
											src={glyph.icon}
											alt={glyph.name}
											width={120}
											height={120}
											class="aspect-square w-full"
										/>
										<span class="font-display mt-1 max-w-full truncate text-[0.6rem] font-semibold uppercase tracking-widest text-zinc-400">
											{glyph.name}
										</span>
									</div>
								</>
							);
						})}
					</div>
				))
			}
		</div>
		<div class="mt-5 flex items-center gap-x-4">
			<button
				type="button"
				id="truths-reset"
				class="btn-pill"
			>
				Reset
			</button>
			<p class="text-xs italic text-zinc-500">
				Missing something here? <a
					href="https://github.com/kasn/d2toolbox"
					target="_blank"
					rel="noreferrer"
					class="link-gold">Let me know!</a>
			</p>
		</div>
	</div>
</section>

<script>
	const MAX_SELECTED = 3;

	const root = document.getElementById("truths");
	const results = document.getElementById("truth-results");
	const reset = document.getElementById("truths-reset");
	const buttons = [
		...(root?.querySelectorAll<HTMLButtonElement>("[data-glyph]") ?? []),
	];
	const rows = [...(root?.querySelectorAll<HTMLElement>("[data-truth]") ?? [])];

	let selected: string[] = [];

	function render() {
		for (const button of buttons) {
			const id = button.dataset.glyph ?? "";
			const isSelected = selected.includes(id);
			button.toggleAttribute("data-selected", isSelected);
			button.disabled = !isSelected && selected.length >= MAX_SELECTED;
		}
		if (results) {
			results.hidden = selected.length === 0;
		}
		for (const row of rows) {
			const symbols = (row.dataset.symbols ?? "").split(",");
			row.hidden = !selected.every((id) => symbols.includes(id));
		}
	}

	for (const button of buttons) {
		button.addEventListener("click", () => {
			const id = button.dataset.glyph ?? "";
			selected = selected.includes(id)
				? selected.filter((s) => s !== id)
				: [...selected, id];
			render();
		});
	}

	reset?.addEventListener("click", () => {
		selected = [];
		render();
	});
</script>
