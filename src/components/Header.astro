---
import DestinyIcon from "@/assets/destiny.svg";
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-b-white/7.5 bg-zinc-950/70 backdrop-blur-md lg:z-30"
>
	<div
		class="mx-auto flex h-14 max-w-screen-2xl items-center justify-between gap-12 px-6 lg:px-12"
	>
		<div class="items-left flex items-center gap-4">
			<a href="/" class="group">
				<DestinyIcon
					class="group-hover:fill-gold h-7 w-7 fill-white transition-colors duration-300"
				/>
			</a>
			<h1
				class="font-display text-xl font-bold uppercase tracking-[0.2em] text-white"
			>
				<a href="/">
					Destiny 2 <span class="text-gold-foreground">Tools</span>
				</a>
			</h1>
		</div>
	</div>
</header>
