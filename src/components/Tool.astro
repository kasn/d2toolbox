---
import { Image } from "astro:assets";
import SocialIcon from "@/components/SocialIcon.astro";
import { toolImage } from "@/lib/images";

type Props = {
	tool: TTool;
	index?: number;
};

const { tool, index = 0 } = Astro.props;
const image = toolImage(tool.slug);
const kicker = tool.category[0] ?? "tool";

// The scrim div below the image is Portal-style: darker toward the
// top-left where the text sits.
---

<li
	data-tool
	data-categories={tool.category.join(",")}
	style={`--card-index: ${index}`}
	class="card-in group relative aspect-[16/10] overflow-hidden shadow-lg shadow-black/50 outline-offset-4 transition duration-200 has-[a:focus-visible]:outline has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-white/90 hover:outline hover:outline-2 hover:outline-white/90"
>
	<a
		href={tool.url}
		target="_blank"
		rel="noreferrer"
		class="absolute inset-0 block focus:outline-none"
	>
		<Image
			src={image}
			widths={[400, 700, 1400]}
			format="webp"
			sizes="(min-width: 1280px) 400px, (min-width: 640px) 50vw, 100vw"
			alt={tool.name}
			loading="lazy"
			class="absolute inset-0 h-full w-full object-cover object-center brightness-[0.55] transition duration-300 group-hover:brightness-90"
		/>

		<div
			class="bg-linear-to-b absolute inset-0 from-zinc-950/70 via-zinc-950/25 to-zinc-950/60"
		>
		</div>

		<div class="absolute inset-x-0 top-0 p-5">
			<p
				class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-white/70"
			>
				{kicker}
			</p>
			<h2
				class="font-display mt-1 text-2xl font-bold leading-7 text-white [text-shadow:0_1px_8px_rgb(0_0_0/0.6)]"
			>
				{tool.name}
			</h2>
		</div>

		<p
			class="absolute inset-x-0 bottom-0 translate-y-2 p-5 text-sm leading-snug text-white/90 opacity-0 transition duration-300 [text-shadow:0_1px_6px_rgb(0_0_0/0.8)] group-hover:translate-y-0 group-hover:opacity-100"
			set:html={tool.description}
		/>
	</a>

	{
		tool.additionalLinks && (
			<ul class="absolute right-0 top-0 m-4 flex gap-x-2 opacity-0 transition duration-300 group-hover:opacity-100">
				{tool.additionalLinks.map((link) => (
					<li>
						<SocialIcon
							url={link}
							label={tool.name}
							size={25}
							bgColor="rgb(255 255 255 / 0.85)"
							fgColor="#000"
						/>
					</li>
				))}
			</ul>
		)
	}
</li>
