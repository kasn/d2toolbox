---
import { Image } from "astro:assets";
import kerrev from "@/components/sundered-doctrine/assets/kerrev.png";
import allpaths from "@/components/sundered-doctrine/assets/riddle-all.png";
import Truths from "@/components/sundered-doctrine/Truths.astro";
import Layout from "@/layouts/Layout.astro";

// glyph image source https://www.reddit.com/r/raidsecrets/comments/t7kea1/vow_callout_images_non_potato_quality/
const maps: {
	title: string;
	image: ImageMetadata;
	alt: string;
	credit: { name: string; url?: string };
	open: boolean;
}[] = [
	{
		title: "Riddle",
		image: allpaths,
		alt: "all paths",
		credit: {
			name: "CyanicKenshi",
			url: "https://www.reddit.com/r/raidsecrets/comments/1ikwarh/sundered_doctrine_1st_encounter_map/",
		},
		open: true,
	},
	{
		title: "Kerrev the Erased",
		image: kerrev,
		alt: "Kerrev the Erased",
		credit: { name: "DIGIPHOENIX" },
		open: false,
	},
];
---

<Layout>
	<article class="not-focus-visible:focus:outline-hidden">
		<header class="card-in mt-4">
			<p
				class="font-display text-gold-foreground flex items-center gap-x-2 text-xs font-semibold uppercase tracking-[0.2em]"
			>
				<span aria-hidden="true" class="text-[0.6rem]">◆</span>
				Dungeon Resources
			</p>
			<h1
				class="font-display mt-2 text-4xl font-bold uppercase tracking-tight text-white sm:text-5xl"
			>
				Sundered <span class="text-gold-foreground">Doctrine</span>
			</h1>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-400">
				Lever riddle solver and encounter maps for the Sundered Doctrine
				dungeon.
			</p>
		</header>

		<div class="mt-10">
			<Truths />
		</div>

		<section class="mt-12 space-y-4" aria-label="Encounter maps">
			{
				maps.map((map, index) => (
					<details
						class="card-in group border border-white/20 bg-zinc-900/60 corner-cut"
						style={`--card-index: ${index + 2}`}
						name="sundered"
						open={map.open}
					>
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 transition-colors duration-75 hover:bg-white/5 [&::-webkit-details-marker]:hidden">
							<h2 class="font-display flex items-center gap-x-2 text-sm font-semibold uppercase tracking-[0.2em] text-white">
								<span
									aria-hidden="true"
									class="text-gold-foreground text-[0.6rem]"
								>
									◆
								</span>
								{map.title}
							</h2>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								class="group-open:rotate-180 pointer-events-none size-4 shrink-0 text-zinc-400 transition-transform duration-200"
							>
								<path d="m6 9 6 6 6-6" />
							</svg>
						</summary>
						<div class="border-t border-white/10 p-4">
							<Image
								src={map.image}
								alt={map.alt}
								width={1000}
								class="h-auto w-full max-w-4xl"
							/>
							<p class="mt-2 text-xs italic text-zinc-500">
								map made by{" "}
								{map.credit.url ? (
									<a
										href={map.credit.url}
										target="_blank"
										rel="noreferrer"
										class="link-gold"
									>
										{map.credit.name}
									</a>
								) : (
									map.credit.name
								)}
							</p>
						</div>
					</details>
				))
			}
		</section>
	</article>
</Layout>
